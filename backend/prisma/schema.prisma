generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "mysql"
}

model Customer {
  id           Int      @id @default(autoincrement())
  fullName     String   @map("full_name") @db.VarChar(120)
  email        String   @unique @map("email") @db.VarChar(255)
  phone        String   @unique @map("phone") @db.VarChar(20)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         String   @default("CUSTOMER") @map("role") @db.VarChar(32)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  carts   Cart[]
  orders  Order[]
  addresses Address[]
  stockAdjustments StockAdjustment[]
  orderStatusChanges OrderStatusHistory[]

  @@map("customers")
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(200)
  category    String    @db.VarChar(100)
  description String    @map("description") @db.Text
  image       String?   @db.VarChar(500)
  price       Decimal?  @map("price") @db.Decimal(10, 2)
  available   Boolean   @default(true) @map("available")
  stockQuantity Int     @default(0) @map("stock_quantity")
  lowStockThreshold Int @default(5) @map("low_stock_threshold")
  archivedAt  DateTime? @map("archived_at") @db.Timestamp(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([archivedAt], map: "products_archived_at_idx")
  @@map("products")
  cartItems CartItem[]
  orderItems OrderItem[]
  stockAdjustments StockAdjustment[]
}

model Inquiry {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(120)
  phone      String   @db.VarChar(20)
  email      String   @db.VarChar(255)
  product    String?  @map("product") @db.VarChar(200)
  message    String   @db.Text
  status     String   @default("PENDING") @map("status") @db.VarChar(32)
  internalNotes String? @map("internal_notes") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("inquiries")
}

model Cart {
  id        Int      @id @default(autoincrement())
  customerId Int     @unique @map("customer_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int      @map("cart_id") @db.Int
  productId Int      @map("product_id") @db.Int
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id") @db.Int
  status     String   @default("pending") @db.VarChar(32)
  total      Decimal? @default(0) @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  // Delivery details collected at checkout
  fullName     String  @map("full_name") @db.VarChar(120)
  phone        String  @map("phone") @db.VarChar(20)
  addressLine1 String  @map("address_line1") @db.VarChar(255)
  addressLine2 String? @map("address_line2") @db.VarChar(255)
  city         String  @db.VarChar(100)
  state        String  @default("Maharashtra") @db.VarChar(100)
  pincode      String  @db.VarChar(10)

  // Payment gateway fields (COD / UPI now, Razorpay-ready)
  paymentMethod   String  @default("cod") @map("payment_method") @db.VarChar(32)
  paymentStatus   String  @default("pending") @map("payment_status") @db.VarChar(32)
  paymentRef      String? @map("payment_ref") @db.VarChar(255)
  razorpayOrderId String? @map("razorpay_order_id") @db.VarChar(255)

  // Durable idempotency: generated once per checkout attempt by the browser
  // (UUID). Unique per customer, so duplicate submissions replay the same order
  // instead of creating a second one. NULL (legacy COD/UPI and test data) is
  // never unique-conflicting in MySQL.
  idempotencyKey String? @map("idempotency_key") @db.VarChar(64)

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  statusHistory OrderStatusHistory[]

  @@unique([customerId, idempotencyKey], map: "orders_customer_idempotency_key")
  @@map("orders")
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int      @map("order_id") @db.Int
  productId  Int      @map("product_id") @db.Int
  quantity   Int
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model StockAdjustment {
  id          Int      @id @default(autoincrement())
  productId   Int      @map("product_id") @db.Int
  adminId     Int      @map("admin_id") @db.Int
  delta       Int      @map("delta")
  reason      String   @map("reason") @db.VarChar(255)
  previousQuantity Int @map("previous_quantity")
  newQuantity   Int   @map("new_quantity")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  admin   Customer @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("stock_adjustments")
}

model OrderStatusHistory {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id") @db.Int
  adminId   Int?     @map("admin_id") @db.Int
  status    String   @map("status") @db.VarChar(32)
  note      String?  @map("note") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  admin  Customer? @relation(fields: [adminId], references: [id])

  @@map("order_status_history")
}

// Provider webhook events (Razorpay). One row per provider event id; the unique
// index on event_id is the durable idempotency guarantee — a redelivered event
// hits a unique violation and is acknowledged without reprocessing.
model WebhookEvent {
  id          Int       @id @default(autoincrement())
  provider    String    @default("razorpay") @db.VarChar(32)
  eventId     String    @map("event_id") @db.VarChar(64)
  eventType   String    @map("event_type") @db.VarChar(64)
  // received (stored, not yet handled) | processed (reconciled/acknowledged) |
  // ignored (no local effect, e.g. unknown order) | failed (mismatch/refused)
  status      String    @default("received") @db.VarChar(32)
  // Short, secret-free explanation for ignored/failed events.
  note        String?   @db.Text
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamp(0)
  processedAt DateTime? @map("processed_at") @db.Timestamp(0)

  @@unique([provider, eventId], map: "webhook_events_provider_event_id")
  @@index([status], map: "webhook_events_status_idx")
  @@map("webhook_events")
}


model Address {
  id           Int      @id @default(autoincrement())
  customerId   Int      @map("customer_id") @db.Int
  fullName     String   @map("full_name") @db.VarChar(120)
  phone        String   @map("phone") @db.VarChar(20)
  addressLine1 String   @map("address_line1") @db.VarChar(255)
  addressLine2 String?  @map("address_line2") @db.VarChar(255)
  city         String   @db.VarChar(100)
  state        String   @default("Maharashtra") @db.VarChar(100)
  pincode      String   @db.VarChar(10)
  landmark     String?  @map("landmark") @db.VarChar(255)
  label        String?  @map("label") @db.VarChar(32)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId], map: "addresses_customer_id_idx")
  @@map("addresses")
}
